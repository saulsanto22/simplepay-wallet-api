		{
			"name": "2. Transactions (Top-Up & Transfer)",
			"item": [
				{
					"name": "2.1 Top-Up Saldo Dompet 1 (Rp 100.000)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"amount\": 100000.00\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/wallets/1/topup",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"wallets",
								"1",
								"topup"
							]
						},
						"description": "Menambahkan saldo sebesar Rp 100.000 ke dompet ID 1 dan mencatat mutasi CREDIT di buku kas."
					},
					"response": []
				},
				{
					"name": "2.2 Transfer Saldo (Dompet 1 ke Dompet 2 - Rp 35.000)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"sourceWalletId\": 1,\n    \"targetWalletId\": 2,\n    \"amount\": 35000.00,\n    \"description\": \"Bayar makan siang & kopi\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/wallets/transfer",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"wallets",
								"transfer"
							]
						},
						"description": "Memindahkan saldo Rp 35.000 dari dompet 1 ke dompet 2 secara ACID transaction dengan Pessimistic Locking & Lock Ordering."
					},
					"response": []
				},
				{
					"name": "2.3 Riwayat Mutasi Dompet 1 (Statement / Ledger)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/wallets/1/transactions",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"wallets",
								"1",
								"transactions"
							]
						},
						"description": "Mengambil seluruh mutasi keluar dan masuk milik dompet ID 1, terurut dari yang terbaru."
					},
					"response": []
				},
				{
					"name": "2.4 Riwayat Mutasi Dompet 2 (Statement / Ledger)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/wallets/2/transactions",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"wallets",
								"2",
								"transactions"
							]
						},
						"description": "Mengambil riwayat mutasi masuk milik dompet ID 2."
					},
					"response": []
				}
			]
		},
