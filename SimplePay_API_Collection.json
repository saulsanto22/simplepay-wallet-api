							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"siti-02\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/wallets",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"wallets"
							]
						},
						"description": "Membuat akun dompet baru untuk user siti-02 sebagai target penerima transfer."
					},
					"response": []
