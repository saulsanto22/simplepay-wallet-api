{
	"info": {
		"_postman_id": "c8e1a345-728b-4b16-9214-7d5a9d81d24c",
		"name": "SimplePay Wallet API",
		"description": "Koleksi API lengkap untuk SimplePay (Core Wallet & Transaction API) dibangun dengan Spring Boot 4 / Java 21.\n\nFitur:\n- Buka Akun Dompet\n- Cek Saldo & Profil\n- Top-Up Saldo\n- Transfer Antar Dompet (Anti-Race Condition & Anti-Deadlock)\n- Riwayat Mutasi Buku Kas (Ledger)\n- Kasus Uji Error (Saldo Kurang, Validasi, Not Found)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Wallet Management",
			"item": [
				{
					"name": "1.1 Buka Dompet Baru (User 1 - Budi)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"budi-01\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/wallets",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"wallets"
							]
						},
						"description": "Membuat akun dompet baru untuk user budi-01. Saldo default awal adalah Rp 0."
					},
					"response": []
				},
				{
					"name": "1.2 Buka Dompet Baru (User 2 - Siti)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
